# =========================
# AUTHENTIFICATION DE L'APP
# =========================
# Compte administrateur local (accès complet, indépendant de Jellyfin)
APP_ADMIN_USER=admin
APP_ADMIN_PASSWORD=change-me
SESSION_SECRET=generate-a-long-random-string
# Mettre à true si l'app est servie en HTTPS (recommandé derrière un reverse proxy)
COOKIE_SECURE=false
# Langue par défaut de l'instance (fr | en | es | de) — utilisée pour tout compte sans préférence enregistrée
APP_LANGUAGE=en

# Compte invité optionnel : lecture seule sur toute l'app, seule action permise
# = ajouter un film/une série (demande). Laisser GUEST_PASSWORD vide désactive
# complètement ce compte (login impossible).
GUEST_USER=guest
GUEST_PASSWORD=

# =========================
# RADARR
# =========================
RADARR_URL=http://radarr:7878
RADARR_API_KEY=

# =========================
# SONARR
# =========================
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=

# =========================
# BAZARR
# =========================
BAZARR_URL=http://bazarr:6767
BAZARR_API_KEY=

# =========================
# JACKETT
# =========================
JACKETT_URL=http://jackett:9117
JACKETT_API_KEY=

# =========================
# JELLYFIN
# =========================
JELLYFIN_URL=http://jellyfin:8096
# URL publique utilisée pour ouvrir Jellyfin depuis l'interface.
JELLYFIN_PUBLIC_URL=https://jellyfin.example.com
JELLYFIN_API_KEY=

# Lecteur vidéo intégré (lire directement dans cine-app au lieu de rediriger
# vers Jellyfin web). Désactivé par défaut : Jellyfin transcode systématiquement
# le flux (H.264/AAC) pour rester lisible sur tous les navigateurs, ce qui a un
# vrai coût CPU/GPU côté serveur à chaque lecture — à activer seulement si ton
# serveur Jellyfin a du transcodage matériel (Quick Sync, NVENC, ...) ou assez
# de CPU pour encaisser du transcodage logiciel.
PLAYER_ENABLED=false

# =========================
# JELLYSEERR
# =========================
JELLYSEERR_URL=http://jellyseerr:5055
JELLYSEERR_API_KEY=

# =========================
# QBITTORRENT
# (qbittorrent partage le netns de gluetun -> on cible le conteneur gluetun)
# =========================
QBITTORRENT_URL=http://gluetun:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=

# =========================
# FICHES FILMS/SÉRIES (optionnel)
# Sans ces clés, les pages détail Radarr/Sonarr fonctionnent normalement,
# simplement sans synopsis enrichi/casting/backdrop (TMDb) ni note IMDb (OMDb).
# TMDb : clé API gratuite sur https://www.themoviedb.org/settings/api
# OMDb : clé API gratuite sur https://www.omdbapi.com/apikey.aspx
# =========================
TMDB_API_KEY=
OMDB_API_KEY=
# MDBList : notes multi-sources (IMDb, Rotten Tomatoes, Metacritic, Letterboxd, Trakt)
# Clé gratuite sur mdblist.com → Settings → API Key (1 000 req/jour, cache serveur inclus)
# Sans cette clé, la section notes n'est simplement pas affichée.
MDBLIST_API_KEY=

# =========================
# NOTIFICATIONS PUSH WEB / PWA
# =========================
# Générer avec :
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Apple Web Push exige un subject valide en mailto: ou URL HTTPS.
VAPID_SUBJECT=mailto:admin@example.com

# =========================
# FONCTIONNALITÉS OPTIONNELLES
# =========================

# Page galerie avancée de Clara Galle (actrice) :
# - false (défaut) : page acteur standard, identique aux autres acteurs
# - true  : active une page dédiée avec galerie photo, biographie détaillée et liens.
#   Requiert un dossier de photos monté dans le conteneur (voir docker-compose.example.yml).
#   Le dossier doit contenir les photos au format JPG/PNG/WebP,
#   ainsi qu'une image nommée "clarabanner.jpg" utilisée comme bannière en haut de page.
CLARA_GALLERY_ENABLED=false

# =========================
# CHEMINS DE STOCKAGE (disque/stats)
# Utilisés par les calculs de stockage (Films/Séries/Seeds/Autre) et le forecast
# de saturation disque. Doivent correspondre au chemin interne du conteneur
# monté dans docker-compose.yml (volume média, voir docker-compose.example.yml).
# Laisser vide = valeurs par défaut ci-dessous (entre parenthèses).
# =========================
# Racine du montage média dans le conteneur (défaut: /mnt/media/video)
MEDIA_ROOT=/mnt/media/video
# Sous-dossiers optionnels, si votre arborescence diffère de la structure par
# défaut Radarr/Sonarr/qBittorrent standard sous MEDIA_ROOT :
# MOVIES_PATH (défaut: $MEDIA_ROOT/movies)
MOVIES_PATH=
# TV_PATH (défaut: $MEDIA_ROOT/tv)
TV_PATH=
# SEEDS_PATH (défaut: $MEDIA_ROOT/downloads/seeds)
SEEDS_PATH=
# SEED_MOVIES_PATH (défaut: $SEEDS_PATH/movies)
SEED_MOVIES_PATH=
# SEED_TV_PATH (défaut: $SEEDS_PATH/tv)
SEED_TV_PATH=
# CROSS_SEED_PATH (défaut: $SEEDS_PATH/cross-seed-links)
CROSS_SEED_PATH=
