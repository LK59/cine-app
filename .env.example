# Laterna — optional environment file.
#
# A new installation needs none of this: the setup assistant and Management → Configuration set
# everything in the browser, and the secrets are generated on first launch. Use this file as a
# fallback, or to keep the configuration as code. Every variable is described in ENV.md.
#
# Order of precedence: the value set in the app, then this file, then the default. A value here
# fills its field in the app; changing it there replaces it until "Back to the .env value".
# Changes to this file apply when the container is recreated: docker compose up -d
#
# Everything is commented out: uncomment only what you set. An empty line (KEY=) is an empty
# value, not the default. An installation whose environment sets Jellyfin, TMDB and Radarr or
# Sonarr skips the setup assistant; so does SETUP_COMPLETE=true.

# ── Services ── also in Management → Configuration → Connections. Addresses are resolved from
# inside the container: container names on a shared Docker network, otherwise a LAN address.
# JELLYFIN_URL=http://jellyfin:8096
# JELLYFIN_API_KEY=
# JELLYFIN_PUBLIC_URL=https://jellyfin.example.com
# TMDB_API_KEY=
# RADARR_URL=http://radarr:7878
# RADARR_API_KEY=
# RADARR_QUALITY_PROFILE=
# SONARR_URL=http://sonarr:8989
# SONARR_API_KEY=
# SONARR_QUALITY_PROFILE=
# JELLYSEERR_URL=http://jellyseerr:5055
# JELLYSEERR_API_KEY=
# QBITTORRENT_URL=http://gluetun:8080
# QBITTORRENT_USERNAME=admin
# QBITTORRENT_PASSWORD=
# BAZARR_URL=http://bazarr:6767
# BAZARR_API_KEY=
# JACKETT_URL=http://jackett:9117
# JACKETT_API_KEY=
# OMDB_API_KEY=
# MDBLIST_API_KEY=

# ── Playback ── also in Management → Configuration → Playback.
# PLAYER_ENABLED=true
# PLAYER_SERVER_FALLBACK=true
# PLAYER_AUTO_FRAME=true
# CHROMECAST_FOR_EVERYONE=true
# CAST_RECEIVER_APP_ID=

# ── Generated subtitles ── also in Management → Configuration → Generated subtitles.
# Without a key the feature does not appear. The key never leaves the server.
# SUBTITLE_GEN_API_KEY=
# SUBTITLE_GEN_PROVIDER=anthropic
# SUBTITLE_GEN_MODEL=
# SUBTITLE_GEN_BUDGET_USD=5
# SUBTITLE_GEN_PRICE_INPUT=
# SUBTITLE_GEN_PRICE_OUTPUT=
# SUBTITLE_GEN_ENABLED=true

# ── Dialogue search ── also in Management → Configuration → Dialogue search.
# Off by default; needs the films folder mounted read-only (MEDIA_ROOT / MOVIES_PATH below).
# REPLIQUES_ENABLED=false
# REPLIQUES_NIGHTLY=true
# REPLIQUES_NIGHT_START=2
# REPLIQUES_NIGHT_END=6
# REPLIQUES_LANGUAGES=fr,original

# ── Defaults for accounts ── also in Management → Configuration → New accounts.
# APP_LANGUAGE=en
# HOME_CONTINUE_HERO=false
# NEW_ACCOUNT_BLOCKED_TAGS=

# ── Application ── also in Management → Configuration → Connections (Application).
# POSTER_PREWARM=true
# VAPID_SUBJECT=mailto:admin@example.com

# ── Deployment only ── read at startup, not settable in the app.
# Time zone for logs and scheduled tasks.
# TZ=Europe/Paris
# Media folder as mounted inside the container (read-only), for the storage figures.
# MEDIA_ROOT=/mnt/media/video
# Sub-folders, only if your layout differs from MEDIA_ROOT/movies, /tv and /downloads/seeds.
# MOVIES_PATH=
# TV_PATH=
# SEEDS_PATH=
# SEED_MOVIES_PATH=
# SEED_TV_PATH=
# CROSS_SEED_PATH=
# POSTER_PREWARM_WIDTHS=384,750
# POSTER_PREWARM_LOCALES=fr,en
# An administrator account fixed here replaces the one the setup assistant creates.
# APP_ADMIN_USER=admin
# APP_ADMIN_PASSWORD=

# ── Never in the app ── see ENV.md before setting these.
# Generated on first launch into data/config/secrets.json when left out. Changing the session
# secret signs everyone out; it must be 16 characters or more (openssl rand -hex 32).
# SESSION_SECRET=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# true once the app is served over HTTPS. Never while testing over http://: no sign-in would work.
# COOKIE_SECURE=false
# The reverse proxy whose X-Forwarded-For is believed: container name, address or IPv4 network.
# TRUSTED_PROXIES=

# ── Development stack only (docker-compose.dev.yml) ──
# DEV_BIND=127.0.0.1
