# =========================
# APP AUTHENTICATION
# =========================
# Local administrator account: full access, independent from Jellyfin. Your way in during setup,
# and the day Jellyfin is unreachable.
# Leaving APP_ADMIN_PASSWORD empty disables the local admin account: only Jellyfin accounts can
# sign in. The server refuses to start if it is left at the old example value "change-me".
APP_ADMIN_USER=admin
APP_ADMIN_PASSWORD=
# Signs and encrypts sessions. Required — generate one with either of:
#   openssl rand -hex 32
#   docker run --rm node:24-alpine node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The server refuses to start while it is empty or absent, shorter than 16 characters, or one of
# the published example values — anyone who knows the secret can forge an admin session.
SESSION_SECRET=
# Set to true when the app is served over HTTPS (recommended, behind a reverse proxy).
COOKIE_SECURE=false
# Default language of this instance (fr | en | es | de) — used on the login page and for any
# account with no saved preference.
APP_LANGUAGE=en

# =========================
# RADARR
# =========================
# All service URLs below are resolved *from inside the container*, not from your browser.
# On a shared Docker network, use container names. Otherwise use a LAN IP; "localhost" would
# mean the container itself.
RADARR_URL=http://radarr:7878
RADARR_API_KEY=

# =========================
# SONARR
# =========================
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=

# =========================
# BAZARR
# =========================
BAZARR_URL=http://bazarr:6767
BAZARR_API_KEY=

# =========================
# JACKETT
# =========================
JACKETT_URL=http://jackett:9117
JACKETT_API_KEY=

# =========================
# JELLYFIN
# =========================
JELLYFIN_URL=http://jellyfin:8096
# Public URL, used to open Jellyfin from the interface.
JELLYFIN_PUBLIC_URL=https://jellyfin.example.com
JELLYFIN_API_KEY=

# Built-in video player (play inside cine-app instead of redirecting to Jellyfin web).
# On by default. The native player reads the file over HTTP byte ranges and repackages it in the
# browser, so ordinary playback costs the server nothing beyond serving bytes — hardware decoding
# and native HDR, no transcode. Set to false to remove in-app playback entirely; the
# "Open in Jellyfin" links keep working.
PLAYER_ENABLED=true

# Is there a server-side player to fall back on?
# - true (default): a file the browser cannot carry is handed to Jellyfin, which negotiates and,
#   if it must, transcodes. That is the safety net that makes any file playable, and it is the
#   only case where a playback can cost the server CPU. It also covers the per-account
#   "previous player" option, which selects the same server-side player deliberately.
# - false: nothing is ever handed to Jellyfin. A file the native path cannot carry ends on a
#   plain playback error naming the reason, and the per-account option is neither offered nor
#   honoured. Choose this for a hard guarantee that no playback can start a transcode.
PLAYER_SERVER_FALLBACK=true

# Enlarge the picture over black bars baked into the file?
# A 2.39:1 film delivered in a 16:9 frame carries its bars in every image, and on a screen wider
# than 16:9 (most phones in landscape) it ends up boxed in black on all four sides. When on, the
# player enlarges the picture until it meets the nearest edge of the screen. It crops black
# only, never a line of picture.
# The measure runs on the server, once per file, from Jellyfin's trickplay thumbnails: no video
# is decoded, it takes a fraction of a second and is cached. It therefore needs trickplay images
# to exist (Jellyfin: Dashboard > Libraries > Trickplay, "Enable trickplay image extraction");
# a file without them is simply shown as it is.
PLAYER_AUTO_FRAME=true

# Prepare the catalogue's posters ahead of time?
# Posters go through Next's image optimizer, which downloads each one from TMDB or TheTVDB,
# resizes it and caches it under ./data/image-cache. The first request for a size costs 60-350 ms,
# later ones 2-3 ms; without this, that first cost falls on whoever opens the screen first, and
# posters visibly appear one by one. When on, the server asks its own optimizer for every poster
# in the sizes the screens use, in the background: a minute after start-up, then every 30 minutes
# for titles added since. Two requests at a time at most.
POSTER_PREWARM=true
# Widths to prepare (default 384,750 — the two most requested by the cinema's screens).
# POSTER_PREWARM_WIDTHS=384,750
# Poster language(s) to prepare: a poster depends on the viewer's language. Default: fr plus
# APP_LANGUAGE.
# POSTER_PREWARM_LOCALES=fr

# =========================
# JELLYSEERR
# =========================
JELLYSEERR_URL=http://jellyseerr:5055
JELLYSEERR_API_KEY=

# =========================
# QBITTORRENT
# (when qBittorrent shares gluetun's network namespace, its address is gluetun's)
# =========================
QBITTORRENT_URL=http://gluetun:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=

# =========================
# MOVIE/SERIES METADATA (optional)
# Without these keys the Radarr/Sonarr detail pages work normally, simply without the enriched
# synopsis, cast and backdrop (TMDb) or the IMDb rating (OMDb).
# TMDb: free API key at https://www.themoviedb.org/settings/api
# OMDb: free API key at https://www.omdbapi.com/apikey.aspx
# =========================
TMDB_API_KEY=
OMDB_API_KEY=
# MDBList: multi-source ratings (IMDb, Rotten Tomatoes, Metacritic, Letterboxd, Trakt).
# Free key at mdblist.com -> Settings -> API Key (1,000 req/day, server-side cache included).
# Without this key the ratings section is simply not displayed.
MDBLIST_API_KEY=

# =========================
# WEB PUSH / PWA NOTIFICATIONS
# =========================
# Generate with (Docker only, no Node needed on the host):
#   docker run --rm node:24-alpine sh -lc "npm install -g web-push >/dev/null && web-push generate-vapid-keys"
# or, if Node is installed on the host:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Apple Web Push requires a valid subject: a mailto: or an HTTPS URL you control.
VAPID_SUBJECT=mailto:admin@example.com

# =========================
# OPTIONAL FEATURES
# =========================

# Enriched gallery page for the actress Clara Galle:
# - false (default): standard person page, identical to every other actor, and every
#   /api/gallery/clara address answers 404
# - true : enables a dedicated page with a photo gallery, a detailed biography and links.
#   Requires a photo folder mounted read-only at /app/gallery/clara (see docker-compose.example.yml):
#   JPG/PNG/WebP photos, plus "clarabanner.jpg" (the banner at the top of the page) and
#   optionally "favicon.jpeg" (the slideshow's icon).
#   Two addresses are then public, no login: /api/gallery/clara/random (a slideshow page, for
#   sharing) and /api/gallery/clara/<file>. The list of files needs a session. The slideshow writes
#   absolute links from the X-Forwarded-Proto / X-Forwarded-Host headers your reverse proxy sends.
CLARA_GALLERY_ENABLED=false

# =========================
# STORAGE PATHS (disk/stats)
# Used by the storage figures (Movies/Series/Seeds/Other) and by the disk saturation forecast.
# They must match the path *inside the container* where your media volume is mounted in
# docker-compose.yml (see docker-compose.example.yml).
# Leave empty to use the defaults shown in parentheses.
# =========================
# Media root inside the container (default: /mnt/media/video)
MEDIA_ROOT=/mnt/media/video
# Optional sub-folders, if your tree differs from the standard Radarr/Sonarr/qBittorrent layout
# under MEDIA_ROOT:
# MOVIES_PATH (default: $MEDIA_ROOT/movies)
MOVIES_PATH=
# TV_PATH (default: $MEDIA_ROOT/tv)
TV_PATH=
# SEEDS_PATH (default: $MEDIA_ROOT/downloads/seeds)
SEEDS_PATH=
# SEED_MOVIES_PATH (default: $SEEDS_PATH/movies)
SEED_MOVIES_PATH=
# SEED_TV_PATH (default: $SEEDS_PATH/tv)
SEED_TV_PATH=
# CROSS_SEED_PATH (default: $SEEDS_PATH/cross-seed-links)
CROSS_SEED_PATH=
